                "14": {
                    "data": {
                        "advanced": {
                            "customName": "note wipe outcome",
                            "customNameId": 0,
                            "description": "This block uses custom code. Adds a note with the result of the wipe for each device.",
                            "join": [],
                            "note": "This block uses custom code. Adds a note with the result of the wipe for each device."
                        },
                        "functionId": 4,
                        "functionName": "note_wipe_outcome",
                        "id": "14",
                        "inputParameters": [],
                        "outputVariables": [],
                        "type": "code"
                    },
                    "errors": {},
                    "id": "14",
                    "type": "code",
                    "userCode": "\n    rows = phantom.collect2(container=container, datapath=[\n        \"wipe_devices:action_result.parameter.device_id\",\n        \"wipe_devices:action_result.status\",\n        \"wipe_devices:action_result.message\"\n    ])\n    if not rows:\n        body = \"_Wipe was not executed._\"\n    else:\n        seen, lines = set(), []\n        for r in rows:\n            did = r[0]\n            if did is None or str(did) in seen:\n                continue\n            seen.add(str(did))\n            icon = \"\u2705 queued\" if str(r[1]).lower() == \"success\" else \"\u26a0\ufe0f FAILED\"\n            lines.append(\"- Device id \" + str(did) + \": \" + icon + (\" \u2014 \" + str(r[2]) if r[2] else \"\"))\n        body = \"## Wipe outcome\\n\\n\" + \"\\n\".join(lines)\n    phantom.add_note(\n        container=container, note_type=\"general\",\n        title=\"Compromised User \u2014 Wipe Outcome\", content=body, note_format=\"markdown\")\n    \n",
                    "warnings": {},
                    "x": 990,
                    "y": 2004
                },
                "15": {
                    "data": {
                        "advanced": {
                            "customName": "format wipe prompt",
                            "customNameId": 0,
                            "description": "This block uses custom code. Lists every device that would be wiped, for the approval prompt.",
                            "join": [],
                            "note": "This block uses custom code. Lists every device that would be wiped, for the approval prompt."
                        },
                        "functionId": 2,
                        "functionName": "format_wipe_prompt",
                        "id": "15",
                        "parameters": [],
                        "template": "",
                        "type": "format"
                    },
                    "errors": {},
                    "id": "15",
                    "type": "format",
                    "userCode": "\n    ids = phantom.collect2(container=container, datapath=[\n        \"find_devices_by_username:action_result.data.*.id\",\n        \"find_devices_by_username:action_result.data.*.general.name\"])\n    def _stat(a):\n        rows = phantom.collect2(container=container, datapath=[\n            a + \":action_result.parameter.device_id\", a + \":action_result.status\"])\n        return {str(x[0]): str(x[1]).lower() for x in rows if x and x[0] is not None}\n    grp, lok = _stat(\"add_to_suspended_group\"), _stat(\"lock_devices\")\n    seen, lines = set(), []\n    for r in ids:\n        did = r[0]\n        if did is None or str(did) in seen:\n            continue\n        seen.add(str(did))\n        ok = grp.get(str(did)) == \"success\" and lok.get(str(did)) == \"success\"\n        lines.append(\"\u2022 \" + str(r[1]) + \" (id \" + str(did) + \")\" + (\"\" if ok else \"  \u26a0\ufe0f NOT fully contained\"))\n    scope = (\"\u26a0\ufe0f You are about to WIPE ALL \" + str(len(lines)) + \" device(s) \u2014 IRREVERSIBLE:\\n\"\n             + \"\\n\".join(lines)\n             + \"\\n\\n(\u26a0\ufe0f-flagged devices failed containment \u2014 review before wiping.)\")\n    template = scope.replace(\"{\", \"{{\").replace(\"}\", \"}}\")\n    parameters = []\n    \n",
                    "warnings": {},
                    "x": 1240,
                    "y": 1280
                },
